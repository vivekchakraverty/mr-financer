# Copy to .env and fill in what you have. Everything is optional: the module
# runs with no keys at all and tells you what each missing source would add.

# --- discovery -------------------------------------------------------------

# Product Hunt: free. Create an app at https://www.producthunt.com/v2/oauth/applications
# then use the "client-only" token (Developer Token also works).
# Billed in complexity points: 6250 per 15 minutes.
MRF_PRODUCTHUNT_TOKEN=
MRF_PRODUCTHUNT_CLIENT_ID=
MRF_PRODUCTHUNT_CLIENT_SECRET=
# Enable for permitted use. Product Hunt requires contact for business use.
MRF_PRODUCTHUNT_ENABLED=true

# Free Open Source Places from the Places Portal. Import an export first.
MRF_FOURSQUARE_SNAPSHOT=
# Optional authenticated refresh. Copy URI, warehouse and table from the
# Places Portal connection snippet. Set a Places Portal catalog token.
MRF_FOURSQUARE_CATALOG_URI=
MRF_FOURSQUARE_CATALOG_WAREHOUSE=
MRF_FOURSQUARE_CATALOG_TABLE=
MRF_FOURSQUARE_CATALOG_TOKEN=
# Optional live Places Search. Requires a Developer Console service key.
MRF_FOURSQUARE_SERVICE_KEY=

# Search API used to find competitors wherever they are listed.
# One of: none | brave | serper | tavily
MRF_SEARCH_PROVIDER=none
MRF_SEARCH_API_KEY=

# --- financials ------------------------------------------------------------

# UK Companies House: FREE official API, and the single best source of real
# filed financials anywhere. Register at
# https://developer.company-information.service.gov.uk/
MRF_COMPANIES_HOUSE_KEY=

# South Korea OpenDART authentication key.
MRF_OPENDART_KEY=
# SEC EDGAR fair-access contact email. The SEC requires no API key.
MRF_SEC_CONTACT=
# France INPI portal credentials, after annual-accounts access is active.
MRF_INPI_USERNAME=
MRF_INPI_PASSWORD=

# Slovakia RegisterUZ and Norway Brønnøysund are keyless.

# Wikidata needs no key and is always on.

# --- scrapers (opt-in, read the warnings in the README) --------------------

# AlternativeTo has no API. Enabling this parses its HTML.
MRF_ENABLE_SCRAPER_ALTERNATIVETO=false

# India MCA has no API and its free lookup is CAPTCHA-gated. Enabling this does
# NOT scrape; it emits manual-lookup links and explains what costs money.
MRF_ENABLE_SCRAPER_MCA=false

# Never set this to false in anything you ship.
MRF_RESPECT_ROBOTS=true

# --- figure validation -----------------------------------------------------

# One knob instead of nine thresholds. Run `mrfinancer settings` to see exactly
# what each profile resolves to and what every threshold changes.
#   strict      withhold anything questionable (investor-facing output)
#   balanced    flag questionable figures, withhold impossible ones (default)
#   permissive  show almost everything (exploration, not documents)
MRF_VALIDATION_PROFILE=balanced

# Optional: override a single threshold on top of the profile. Leave commented
# unless you have a reason.
# MRF_MAX_EMPLOYEES=250000
# MRF_MAX_REVENUE_PER_EMPLOYEE=10000000
# MRF_SCALE_JUMP_TOLERANCE=0.15
# MRF_REQUIRE_CURRENCY=true

# --- behaviour -------------------------------------------------------------

MRF_MAX_COMPETITORS=12
MRF_REQUESTS_PER_SECOND=1.0
MRF_MAX_CONCURRENCY=4
MRF_MIN_SIMILARITY=0.25

# The entity-resolution floor. Below this we refuse to attach a company's
# financials to a product. Lowering it trades safety for coverage, and the
# failure it prevents is reporting the wrong company's revenue.
MRF_MIN_COMPANY_MATCH_CONFIDENCE=0.80

# URL for the business plan Gradio Space
MRF_BUSINESS_PLAN_SPACE_URL=https://vivekchakraverty-mr-financer-business-plan.hf.space

# Optional company research review providers. Google review fields require a billing-enabled project.
# Trustpilot requires an API key with access to the business-unit reviews endpoint.
MRF_TRUSTPILOT_API_KEY=
MRF_GOOGLE_PLACES_API_KEY=

# --- G2 optional product/review provider (separate from Business Plan) ---
# Configure ONE of MRF_G2_API_KEY or g2_api in your server environment.
# Never put a G2 access token into JavaScript, publicly hosted .env files, or Git.
MRF_G2_API_KEY=
# 1,000 is an OPERATOR cap and is NOT a promise of your actual G2 plan quota.
MRF_G2_GLOBAL_MONTHLY_LIMIT=1000
# Must point to durable, shared persistent storage for all app worker processes.
MRF_G2_USAGE_DB=.mrfinancer-g2-usage.sqlite


# Path to an imported angel investor directory owned by this installation.
# MRF_INVESTOR_DIRECTORY=private-data/angel-investors.json.gz
